                    "condition": {
                        "all": [
                            {
                                "kind": "has_item",
                                "item_id": "item_shard_courage"
                            },
                            {
                                "kind": "has_item",
                                "item_id": "item_shard_wisdom"
                            },
                            {
                                "not": {
                                    "kind": "flag",
                                    "flag": "triad_forged"

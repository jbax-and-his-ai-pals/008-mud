                    "next_node": "bathed",
                    "effects": {
                        "restore": {
                            "resource": "all",
                            "companions": true
                        },
                        "message": "The water is cool and bright, and every ache goes out of you."
                    }
                },
                {
                    "text": "Come with me. The deep places are lonely.",
                    "condition": {
                        "not": {
                            "kind": "companion_present",
                            "npc_id": "pool_fairy"
                        }
                    },
                    "next_node": "joins",
                    "effects": {
                        "recruit": true
                    }
                },
                {
                    "text": "Stay here, little one.",
                    "condition": {
                        "kind": "companion_present",
                        "npc_id": "pool_fairy"
                    },
                    "next_node": "stays",
                    "effects": {
                        "dismiss": true
                    }
                },
                {
                    "text": "Goodbye.",
                    "end": true
                }
            ]
        },
        "joins": {
            "text": "Oh! Yes. I have not seen the sun in a hundred seasons.",
            "end": true
        },
        "stays": {
            "text": "I will keep the water warm for you.",
            "end": true
        },
        "bathed": {
            "text": "There. Go well. Mind the deep places.",
            "end": true
        }

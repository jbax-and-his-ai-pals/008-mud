  "weather": {
    "descriptions": {
      "windy": "A hard wind worries loose cloth and carries grit along the road.",
      "mist": "Low mist clings to the ground and blurs the distance.",
      "blizzard": "Snow and wind erase the far country behind a white wall.",
      "sandstorm": "A wall of sand rasps across the open country and blots out the horizon.",
      "dappled": "Sunlight breaks through the canopy in shifting patches of light and shade.",
      "muddy": "Rain has turned the open ground to thick, sucking mud."
    },
    "profiles": {
      "coast": {
        "map": {
          "clear": "windy"
        },
        "travel_notes": {
          "storm": "The coastal road is slick and exposed beneath the storm."
        }
      },
      "alpine": {
        "map": {
          "clear": "windy",
          "rain": "snow",
          "storm": "blizzard"
        },
        "travel_notes": {
          "windy": "The high-country wind makes every exposed step deliberate.",
          "blizzard": "The mountain route is barely visible through the blowing snow."
        }
      },
      "swamp": {
        "map": {
          "clear": "mist",
          "cloudy": "mist"
        },
        "travel_notes": {
          "mist": "The marsh trail fades into the mist; keep to the firmer ground."
        }
      },
      "desert": {
        "map": {
          "clear": "windy",
          "storm": "sandstorm"
        },
        "travel_notes": {
          "windy": "The dry wind steals moisture faster than it seems.",
          "sandstorm": "Shelter and a wrapped face are worth more than speed in the sandstorm."
        }
      },
      "forest": {
        "map": {
          "clear": "dappled"
        },
        "travel_notes": {
          "dappled": "Sunlight breaks through the canopy in shifting patches; the deeper trails are easy to lose.",
          "storm": "Wind lashes the canopy overhead, and fallen branches litter the trail."
        }
      },
      "foothills": {
        "map": {
          "clear": "windy"
        },
        "travel_notes": {
          "windy": "The open foothill trails offer no windbreak; every gust tests your footing."
        }
      },
      "farmland": {
        "map": {
          "rain": "muddy"
        },
        "travel_notes": {
          "muddy": "The furrowed fields turn to mud in the rain; the road here is little better."
        }
      },
      "underground": {
        "map": {}
      }
    }
  },

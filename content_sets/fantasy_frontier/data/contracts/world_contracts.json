{
  "schema_version": 1,
  "label": "Fantasy Frontier contracts",
  "_comment": "What this content set declares things to BE. The engine resolves item_family -> item_class and generation_profile -> roll tables from here, so it never has to know the word 'gem'. Adding a sci-fi set means declaring families like 'energy_cell' and 'alloy_plate' beside these; nothing in server/engine changes. See docs/design/cross_theme_engine_contracts.md.",
  "resources": [
    {
      "id": "health",
      "label": "Health",
      "short": "HP",
      "kind": "vital",
      "regenerates": false,
      "max_stat": "constitution"
    },
    {
      "id": "mana",
      "label": "Mana",
      "short": "MP",
      "kind": "ability",
      "_comment": "The ability pool. `max_stat` drives how large it is and `regeneration_stat` how fast it refills -- both read by engine/contracts/resources.py, so a set whose abilities draw on something else declares its own resource and inherits nothing.",
      "regenerates": true,
      "regeneration_stat": "wisdom",
      "max_stat": "intelligence"
    }
  ],
  "item_families": [
    {

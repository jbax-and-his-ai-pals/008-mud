    "guardian_wakes": {
        "on": {
            "event": "searched",
            "region": "ashgrave",
            "room": "gy_guardians"
        },
        "once": "world",
        "effects": {
            "spawn_npc": {
                "npc": "stone_guardian",
                "region": "ashgrave",
                "room": "gy_guardians",
                "instance_id": "guardian_awake"
            },
            "message": "You kneel to look under the nearest statue, and it moves: the stone sword comes up, and the statue steps down off its plinth."
        }
    },
    "guardian_falls": {
        "on": {
            "event": "npc_killed",
            "npc": "stone_guardian"
        },
        "once": "world",
        "effects": {
            "give_item": "item_bracer",
            "message": "The guardian breaks into a heap of stone. Under the plinth it stood on is a broad bracer of leather and iron."
        }
    },

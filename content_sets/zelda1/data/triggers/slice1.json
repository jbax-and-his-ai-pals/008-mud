    "the_lair_begins": {
        "on": {
            "event": "on_enter",
            "region": "ghaldur_lair",
            "room": "g_a"
        },
        "once": "world",
        "effects": {
            "set_flag": [
                "gh_stage_1",
                "gh_in_a"
            ],
            "message": "A voice speaks, very close and no louder than a breath: 'You came so far to find a room with no one in it.' The cold on your skin is not from the stair."
        }
    },
    "find_s1": {
        "on": {
            "event": "searched",
            "region": "ghaldur_lair",
            "room": "g_a"
        },
        "once": false,
        "when": {
            "all": [
                {
                    "kind": "flag",
                    "flag": "gh_stage_1"
                },
                {
                    "kind": "flag",
                    "flag": "gh_in_a"
                }
            ]
        },
        "effects": {
            "spawn_npc": {
                "npc": "ghaldur_s1",
                "region": "ghaldur_lair",
                "room": "g_a",
                "instance_id": "ghaldur_s1"
            },
            "message": "You search the room, and the air in it folds back like a curtain: Ghaldur is standing three paces from you, and he is not pleased to be seen."
        }
    },
    "vanish_s1": {
        "on": {
            "event": "health_below",
            "who": "ghaldur_s1",
            "fraction": 0.6
        },
        "once": "world",
        "effects": {
            "remove_npc": "ghaldur_s1",
            "set_flag": [
                {
                    "name": "gh_in_a",
                    "value": false
                },
                {
                    "name": "gh_stage_1",
                    "value": false
                },
                "gh_in_b",
                "gh_stage_2"
            ],
            "message": "Ghaldur flinches, and laughs, and is gone: the air where he stood snaps shut like a door. Somewhere else in the lair, very close, something draws a breath."
        }
    },

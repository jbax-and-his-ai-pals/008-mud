    "purse_30": {
        "on": {
            "event": "item_taken",
            "item": "item_purse_30"
        },
        "once": false,
        "when": {
            "kind": "has_item",
            "item_id": "item_purse_30"
        },
        "effects": {
            "give_gold": 30,
            "take_item": "item_purse_30",
            "message": "You gather up the stones: 30 rupees."

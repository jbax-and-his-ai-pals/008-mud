    "great_hydra_falls": {
        "on": {
            "event": "npc_killed",
            "npc": "great_hydra"
        },
        "once": "world",
        "effects": {
            "give_item": "item_shard_8",
            "set_flag": "shard_8",
            "raise": {
                "max_health": 16
            },
            "restore": {
                "resource": "all"
            },
            "message": "The great hydra's body falls into the pit and the necks fall after it. The eighth and last sliver of the Starcrown lies in the bones. All eight are yours, and a warmth runs through you."
        }
    },

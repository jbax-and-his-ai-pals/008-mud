    "aquilor_falls": {
        "on": {
            "event": "npc_killed",
            "npc": "aquilor"
        },
        "once": "world",
        "effects": {
            "give_item": "item_shard_1",
            "set_flag": "shard_1",
            "raise": {
                "max_health": 16
            },
            "restore": {
                "resource": "all"
            },
            "message": "The drake falls, and the roost goes quiet. A sliver of bright crown lies in the ash where it lay, and a warmth runs through you: you have more heart than you had."
        }
    },

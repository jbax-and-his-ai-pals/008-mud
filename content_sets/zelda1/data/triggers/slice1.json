{
    "purse_5": {
        "on": {
            "event": "item_taken",
            "item": "item_purse_5"
        },
        "once": false,
        "when": {
            "kind": "has_item",
            "item_id": "item_purse_5"
        },
        "effects": {
            "give_gold": 5,
            "take_item": "item_purse_5",
            "message": "You gather up the stones: 5 rupees."
        }
    },
    "purse_10": {

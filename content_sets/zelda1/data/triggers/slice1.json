    "ghaldur_falls": {
        "on": {
            "event": "npc_killed",
            "npc": "ghaldur_s4"
        },
        "once": "world",
        "effects": {
            "set_flag": "ghaldur_down",
            "reveal_exit": {
                "room": "ghaldur_lair:g_c",
                "direction": "up"
            },
            "message": "The silver goes in, and Ghaldur stops being a man or a shape or a voice. A scream goes out of him, and a long way off a door unlocks. In the throne room, a stair has opened up behind the throne."
        }
    }

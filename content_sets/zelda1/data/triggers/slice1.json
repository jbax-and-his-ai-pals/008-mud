    "pipe_pool": {
        "on": {
            "event": "item_used",
            "item": "item_reed_pipe",
            "region": "ardenmoor_north",
            "room": "an_1_1"
        },
        "once": "world",
        "effects": {
            "reveal_exit": {
                "room": "ardenmoor_north:an_1_1",
                "direction": "in"
            },
            "message": "The black water shivers at the tune, and clears, and a stair of wet stone shows beneath it, going down to a bright place."
        }
    },
    "pipe_eye": {
        "on": {
            "event": "item_used",
            "item": "item_reed_pipe",
            "region": "gecko_halls",
            "room": "g_boss"
        },
        "once": "world",
        "effects": {
            "remove_npc": "eye_large",
            "spawn_npc": {
                "npc": "burrowing_eye_small",
                "region": "gecko_halls",
                "room": "g_boss",
                "instance_id": "eye_small"
            },
            "message": "The tune goes out into the room, and the great eye stops rolling. It shudders, and shrinks, and shrinks, and sits blinking in the dust at the size of a boulder, furious."
        }
    },

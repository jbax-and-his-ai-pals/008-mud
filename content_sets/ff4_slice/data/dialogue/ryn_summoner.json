    "nodes": {
        "greeting": {
            "text": "The fog... the ring... my mother... Are you the one they sent?",
            "pace": "slow",
            "choices": [
                {
                    "text": "Sit. Breathe. I am here.",
                    "next_node": "calm"
                },
                {
                    "text": "Goodbye.",
                    "end": true
                }
            ]
        },
        "calm": {
            "text": "The fog has hung over this village for as long as I have lived. My mother's songs kept it asleep. Then your package came, with that red ring inside it, and the fog woke and answered. Please: end the thing in the square, and come back to me.",
            "pace": "slow",
            "end": true
        },
        "relief": {
            "text": "You ended it. The fog is only fog again... Mother's songs held it for years, and one ring undid them in a breath. I can sing them now, a little. Will you let me teach you?",
            "pace": "slow",
            "effects": {
                "complete_quest": "quest_fog_drake"
            },
            "choices": [
                {
                    "text": "Teach me.",
                    "condition": {
                        "not": {
                            "kind": "flag",
                            "flag": "ryn_taught"
                        }
                    },
                    "next_node": "taught",
                    "effects": {
                        "teach_spell": "call_titan",
                        "set_flag": "ryn_taught"
                    }
                },
                {
                    "text": "Come with me, Ryn. Titans answer better with you beside me.",
                    "condition": {
                        "all": [
                            {
                                "kind": "flag",
                                "flag": "ryn_taught"
                            },
                            {
                                "not": {
                                    "kind": "companion_present",
                                    "npc_id": "ryn"
                                }
                            }
                        ]
                    },
                    "next_node": "joins",
                    "effects": {
                        "recruit": true
                    }
                },
                {
                    "text": "Not now.",
                    "end": true
                }
            ]
        },
        "thanks": {
            "text": "I can call the titans. Mother taught me before... before. Do you want the calling song?",
            "pace": "slow",
            "choices": [
                {
                    "text": "Teach me.",
                    "condition": {
                        "not": {
                            "kind": "flag",
                            "flag": "ryn_taught"
                        }

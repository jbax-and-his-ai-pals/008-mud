                },
                {
                    "text": "Come with me, Ryn. Titans answer better with you beside me.",
                    "condition": {
                        "all": [
                            {
                                "kind": "flag",
                                "flag": "ryn_taught"
                            },
                            {
                                "not": {
                                    "kind": "companion_present",
                                    "npc_id": "ryn"
                                }
                            }

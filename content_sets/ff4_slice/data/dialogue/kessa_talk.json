    "nodes": {
        "greeting": {
            "text": "There you are. I heard the bells, and then I heard the king sent for you. Did you speak to him?",
            "pace": "slow",
            "choices": [
                {
                    "text": "He sends me to Hazevale with a package.",
                    "condition": {
                        "kind": "flag",
                        "flag": "obeyed_king"
                    },
                    "next_node": "briefed_obeyed",
                    "effects": {
                        "set_flag": "kessa_briefed"
                    }
                },
                {
                    "text": "He stripped me of my seal. I am to run his errand.",
                    "condition": {
                        "kind": "flag",
                        "flag": "questioned_king"
                    },
                    "next_node": "briefed_stripped",
                    "effects": {
                        "set_flag": "kessa_briefed"
                    }
                },
                {
                    "text": "Not yet.",
                    "next_node": "not_yet"
                }
            ]
        },
        "briefed_obeyed": {
            "text": "A package for the mayor of Hazevale? Strange work for a captain. Then we leave at dawn, together; I would rather not watch the fleet sail without us. Sleep, Aldric. Your quarters are through the north door, and I will meet you at the gate.",
            "pace": "slow",
            "end": true
        },
        "briefed_stripped": {
            "text": "Then he has made a mistake, and I will not watch it happen twice. We leave at dawn, together, and he can court-martial us both. Sleep. Your quarters are through the north door, and I will meet you at the gate.",
            "pace": "slow",
            "end": true
        },
        "not_yet": {
            "text": "Then go, and quickly. The king does not like to be kept waiting, and neither do I.",
            "pace": "slow",
            "end": true
        },
        "rest_first": {
            "text": "Sleep first. Your quarters are through the north door. I will be at the gate at dawn.",
            "pace": "slow",
            "end": true
        },
        "at_the_gate": {
            "text": "Dawn, and I have been up for an hour already. The road to Hazevale is south of here. Are you ready?",
            "pace": "slow",
            "choices": [
                {
                    "text": "Ready. Ride with me, Kessa.",
                    "next_node": "joins",
                    "effects": {
                        "recruit": true,
                        "set_flag": "kessa_joined"
                    }
                },
                {
                    "text": "A moment more.",
                    "next_node": "not_yet_dawn"
                }
            ]
        },
        "not_yet_dawn": {
            "text": "Do not make me wait too long. I am not good at it.",
            "pace": "slow",
            "end": true
        },
        "joins": {
            "text": "Good. Then we do this the way we were taught: side by side.",
            "pace": "slow",
            "end": true
        },
        "rejoin": {
            "text": "Back on the road? I thought you would never ask.",
            "pace": "slow",
            "choices": [
                {
                    "text": "Ride with me again, Kessa.",
                    "next_node": "joins",
                    "effects": {
                        "recruit": true,
                        "set_flag": "kessa_joined"
                    }
                },
                {
                    "text": "Not yet.",
                    "end": true
                }
            ]
        },
        "with_you": {
            "text": "Lead on, Captain. I am right behind you.",
            "pace": "slow",
            "choices": [
                {
                    "text": "Hold here, Kessa. I will send for you.",
                    "next_node": "stays",
                    "effects": {
                        "dismiss": true
                    }
                },
                {
                    "text": "Nothing. Lead on.",
                    "end": true
                }
            ]
        },
        "stays": {
            "text": "Then I will hold here. Send word when you need a blade.",
            "pace": "slow",
            "end": true
        },
        "catching_her_breath": {
            "text": "Give me a moment, Captain. That thing cut deeper than I let on. I will catch my breath and find you the moment I can stand beside you again.",
            "pace": "slow",
            "end": true
        }
    }
}
                {
                    "kind": "flag",
                    "flag": "guards_fight"
                },
                {
                    "not": {
                        "kind": "flag",
                        "flag": "guards_beaten"
                    }
                }
            ]
        },
        "once": "player",
        "effects": {
            "play_scene": "after_the_guards"
        }
    },
    "sickroom_visit": {

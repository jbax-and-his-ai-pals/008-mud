{
    "reach_the_inn": {
        "on": {
            "event": "on_enter",
            "region": "dunhallow",
            "room": "inn"
        },
        "when": {
            "all": [
                {
                    "kind": "flag",
                    "flag": "ryn_carried"
                },
                {
                    "not": {
                        "kind": "flag",
                        "flag": "reached_the_inn"
                    }
                }
            ]
        },
        "once": "player",
        "effects": {
            "play_scene": "reach_the_inn"
        }
    },
    "reach_dunhallow": {
        "on": {
            "event": "on_enter",
            "region": "dunhallow",
            "room": "gate"
        },
        "once": "player",
        "effects": {
            "set_respawn": {
                "region": "dunhallow",
                "room": "gate"
            }
        }
    },
    "guards_beaten": {
        "on": {
            "event": "room_cleared",
            "region": "dunhallow",

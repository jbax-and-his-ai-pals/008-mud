{
    "ilmara_falls": {
        "on": {
            "event": "on_enter",
            "region": "ilmara",
            "room": "crystal_chamber"
        },
        "once": "player",
        "effects": {
            "play_scene": "ilmara_falls"
        }
    },
    "crystal_taken": {
        "on": {
            "event": "item_taken",
            "item": "item_ilmaran_crystal"
        },
        "once": "player",
        "effects": {
            "play_scene": "leave_ilmara"
        }
    },
    "air_first_wave_down": {
        "on": {
            "event": "room_cleared",
            "region": "airship",
            "room": "deck"
        },
        "once": "player",
        "effects": {
            "play_scene": "second_wave"
        }
    },
    "air_second_wave_down": {
        "on": {
            "event": "room_cleared",
            "region": "airship",
            "room": "deck"
        },
        "when": {
            "kind": "flag",
            "flag": "air_second_wave"
        },
        "once": "player",
        "effects": {
            "play_scene": "landing"
        }
    },
    "night_at_the_castle": {
        "on": {
            "event": "on_enter",
            "region": "varenholt",
            "room": "quarters"
        },
        "when": {
            "kind": "flag",
            "flag": "kessa_briefed"
        },
        "once": "player",
        "effects": {
            "play_scene": "night_in_the_castle"
        }
    },
    "throne_court": {
        "on": {
            "event": "on_enter",
            "region": "varenholt",
            "room": "throne_room"
        },
        "once": "player",
        "effects": {
            "message": "The banners hang motionless. Nobody near the king meets your eye."
        }
    },
    "fog_ambush": {
        "on": {
            "event": "on_enter",
            "region": "fogreach",
            "room": "entry"
        },
        "once": "world",
        "effects": {
            "message": "Fog rolls out of the cave mouth in a slow wave, and something small and red grins in it.",
            "spawn_npc": {
                "npc": "cave_imp",
                "region": "fogreach",
                "room": "entry",
                "instance_id": "imp_ambush"
            }
        }
    },
    "drake_falls": {
        "on": {
            "event": "npc_killed",
            "npc": "fog_drake"
        },
        "once": "world",
        "effects": {
            "play_scene": "drake_unravels"
        }
    },
    "ilmara_cleared": {
        "on": {
            "event": "npc_killed",
            "npc": "ilmaran_acolyte"
        },
        "when": {
            "not": {
                "kind": "npc_present",
                "npc_id": "ilmaran_acolyte"
            }
        },
        "once": "player",
        "effects": {
            "play_scene": "ilmara_aftermath"
        }
    }
}
            "weapon_damage_type": "slashing",
            "phases": [
                {
                    "name": "solid",
                    "seconds": 12,
                    "message": "[[RED]]The mist drains out of the Fog Drake, and its scales harden, grey and wet.[[/]]",
                    "hint": {
                        "npc": "captain_kessa",
                        "text": "It has hardened! Hit it now!"
                    }
                },
                {
                    "name": "mist",
                    "seconds": 10,
                    "untouchable": true,
                    "message": "[[RED]]The Fog Drake loses its edges and thins into mist.[[/]]",
                    "miss_text": "The blow passes through the mist, and finds nothing.",
                    "counter": "mist_breath",
                    "counter_cooldown": 4,
                    "hint": {
                        "npc": "captain_kessa",
                        "text": "It has turned to mist! Hold your blows until it hardens!"
                    },
                    "counter_hint": {
                        "npc": "captain_kessa",
                        "text": "Stop! You cannot hurt it like this. Wait for it to harden!"
                    }
                }
            ]
        },
        "usable_spells": [
            "fog_breath"
        ],
        "max_mana": 60

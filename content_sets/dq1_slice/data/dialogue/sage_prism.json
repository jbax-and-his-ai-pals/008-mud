                            },
                            {
                                "kind": "has_item",
                                "item_id": "item_ostruns_signet"
                            }
                        ]
                    }
                }
            ]
        },
        "made": {
            "text": "Carry it to the shore south-east of Telgard, to the water's edge across from the dark isle. Pour it out there. The Lightbearer's way will rise to meet you.",
            "pace": "slow",
            "end": true
        },
        "after": {
            "text": "The prism will answer at the water, and only there. Go well, heir.",
            "pace": "slow",
            "end": true

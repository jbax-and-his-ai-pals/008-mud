[run]
branch = True
data_file = .coverage
parallel = True
source =
    engine
    ../toolkit
omit =
    */__pycache__/*
    */tests/*
    */tests_quarantine/*

[report]
precision = 1
skip_covered = False
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError

[html]
directory = ../coverage_html

[node name="TipsLabel" type="RichTextLabel" parent="OnboardingOverlay/CenterContainer/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 300)
bbcode_enabled = true
text = "[b]Getting started[/b]\n• Type a command and press [b]Enter[/b] (or click Send)\n• Try [b]look[/b] to see your surroundings\n• Try [b]go north[/b]  [b]status[/b]  [b]inventory[/b]\n\n[b]Live authoring shell[/b]\n• [b]@dig <asset_id>[/b] — acquire edit lock\n• [b]@dig <asset_id> renew[/b] — renew lock lease\n• [b]@dig <asset_id> release[/b] — release lock\n• [b]@edit <asset_id> next[/b] — submit next revision\n\n[b]History and scrolling[/b]\n• [b]Up / Down[/b] — browse past commands\n• [b]PageUp / PageDown[/b] — scroll the log\n• [b]Escape[/b] — refocus the input\n\n[b]Client customisation[/b]\n• [b]theme list[/b] — browse visual themes\n• [b]a11y list[/b] — accessibility presets (high contrast, etc.)\n• [b]keybind list[/b] — view and remap keys\n\nType [b]onboarding show[/b] to see this again at any time."

[node name="DismissButton" type="Button" parent="OnboardingOverlay/CenterContainer/Panel/VBox"]
